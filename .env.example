# Copy to .env.local and fill in. .env.local is gitignored.
# Server-only: used by /api/ai/chat to call OpenRouter. Never exposed to the browser.
OPENROUTER_API_KEY=
# Optional: override the OpenRouter API base (for a proxy or local mock).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Daily AI spend limit in USD across all models (default 1). Resets at local midnight.
# AI_DAILY_LIMIT_USD=1
